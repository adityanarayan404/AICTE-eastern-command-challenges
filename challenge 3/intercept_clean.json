": 1.4836601307189543, "no_speech_prob": 0.018961096182465553}, {"id": 20, "seek": 5500, "start": 59.0, "end": 61.0, "text": " Come in.", "tokens": [50564, 2492, 294, 13, 50664], "temperature": 0.0, "avg_logprob": -0.3140409981332174, "compression_ratio": 1.4836601307189543, "no_speech_prob": 0.018961096182465553}, {"id": 21, "seek": 5500, "start": 61.0, "end": 63.0, "text": " That'd be so nice of you to do that.", "tokens": [50664, 663, 1116, 312, 370, 1481, 295, 291, 281, 360, 300, 13, 50764], "temperature": 0.0, "avg_logprob": -0.3140409981332174, "compression_ratio": 1.4836601307189543, "no_speech_prob": 0.018961096182465553}, {"id": 22, "seek": 5500, "start": 73.0, "end": 75.0, "text": " Hey.", "tokens": [51264, 1911, 13, 51364], "temperature": 0.0, "avg_logprob": -0.3140409981332174, "compression_ratio": 1.4836601307189543, "no_speech_prob": 0.018961096182465553}, {"id": 23, "seek": 5500, "start": 75.0, "end": 78.0, "text": " I'm going to have dinner with the queen.", "tokens": [51364, 286, 478, 516, 281, 362, 6148, 365, 264, 12206, 13, 51514], "temperature": 0.0, "avg_logprob": -0.3140409981332174, "compression_ratio": 1.4836601307189543, "no_speech_prob": 0.018961096182465553}, {"id": 24, "seek": 5500, "start": 78.0, "end": 80.0, "text": " She's been out in the sun for a long time.", "tokens": [51514, 1240, 311, 668, 484, 294, 264, 3295, 337, 257, 938, 565, 13, 51614], "temperature": 0.0, "avg_logprob": -0.3140409981332174, "compression_ratio": 1.4836601307189543, "no_speech_prob": 0.018961096182465553}, {"id": 25, "seek": 5500, "start": 80.0, "end": 82.0, "text": " That's what the note says.", "tokens": [51614, 663, 311, 437, 264, 3637, 1619, 13, 51714], "temperature": 0.0, "avg_logprob": -0.3140409981332174, "compression_ratio": 1.4836601307189543, "no_speech_prob": 0.018961096182465553}, {"id": 26, "seek": 8200, "start": 82.0, "end": 84.0, "text": " And it's ambrose.", "tokens": [50364, 400, 309, 311, 669, 1443, 541, 13, 50464], "temperature": 0.4, "avg_l
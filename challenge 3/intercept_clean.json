9, "seek": 11100, "start": 124.0, "end": 127.0, "text": " But I somehow thought the queen wouldn't mind.", "tokens": [51014, 583, 286, 6063, 1194, 264, 12206, 2759, 380, 1575, 13, 51164], "temperature": 0.0, "avg_logprob": -0.28746815080995913, "compression_ratio": 1.475770925110132, "no_speech_prob": 0.001388656790368259}, {"id": 40, "seek": 11100, "start": 127.0, "end": 130.0, "text": " Well, when we got there...", "tokens": [51164, 1042, 11, 562, 321, 658, 456, 485, 51314], "temperature": 0.0, "avg_logprob": -0.28746815080995913, "compression_ratio": 1.475770925110132, "no_speech_prob": 0.001388656790368259}, {"id": 41, "seek": 11100, "start": 130.0, "end": 133.0, "text": " Your Majesty, Captain Charles Bedley,", "tokens": [51314, 2260, 10665, 11, 10873, 10523, 19893, 3420, 11, 51464], "temperature": 0.0, "avg_logprob": -0.28746815080995913, "compression_ratio": 1.475770925110132, "no_speech_prob": 0.001388656790368259}, {"id": 42, "seek": 11100, "start": 133.0, "end": 135.0, "text": " Mr. Ensemblish.", "tokens": [51464, 2221, 13, 2193, 15750, 1933, 13, 51564], "temperature": 0.0, "avg_logprob": -0.28746815080995913, "compression_ratio": 1.475770925110132, "no_speech_prob": 0.001388656790368259}, {"id": 43, "seek": 11100, "start": 135.0, "end": 138.0, "text": " Oh, you Captain Bedley, Mr. Ensemblish.", "tokens": [51564, 876, 11, 291, 10873, 19893, 3420, 11, 2221, 13, 2193, 15750, 1933, 13, 51714], "temperature": 0.0, "avg_logprob": -0.28746815080995913, "compression_ratio": 1.475770925110132, "no_speech_prob": 0.001388656790368259}, {"id": 44, "seek": 11100, "start": 138.0, "end": 140.0, "text": " I'm very glad to see you.", "tokens": [51714, 286, 478, 588, 5404, 281, 536, 291, 13, 51814], "temperature": 0.0, "avg_logprob": -0.28746815080995913, "compression_ratio": 1.475770925110132, "no_speech_prob": 0.001388656790368259}, {"id": 45, "seek": 14000, "start": 140.0, "end": 142.0, "text": " How are you doing, Your Majesty?", "tokens": [50364, 1012, 366, 291, 884, 11, 2260, 10665, 30, 50464], "temperature": 0.0, "avg_logprob": -0.27487628173828127, "compression_ratio": 1.5454545454545454, "no_speech_prob": 0.0409037284553051}, {"id": 46, "seek": 14000, "start": 142.0, "end": 144.0, "text": " It was very nice of you to come.", "tokens": [50464, 467, 390, 588, 1481, 295, 291, 281, 808, 13, 50564], "temperature": 0.0, "avg_logprob": -0.27487628173828127, "compression_ratio": 1.5454545454545454, "no_speech_prob": 0.0409037284553051}, {"id": 47, "seek": 14000, "start": 144.0, "end": 146.0, "text": " It was nice of us.", "tokens": [50564, 467, 390, 1481, 295, 505, 13, 50664], "temperature": 0.0, "avg_logprob": -0.27487628173828127, "compression_ratio": 1.5454545454545454, "no_speech_prob": 0.0409037284553051}, {"id": 48, "seek": 14000, "start": 146.0, "end": 147.0, "text": " Golly.", "tokens": [50664, 1037, 13020, 13, 50714], "temperature": 0.0, "avg_logprob": -0.27487628173828127, "compression_ratio": 1.5454545454545454, "no_speech_prob": 0.0409037284553051}, {"id": 49, "seek": 14000, "start": 147.0, "end": 149.0, "text": " I think Christmas is the time", "tokens": [50714, 286, 519, 5272, 307, 264, 565, 50814], "temperature": 0.0, "avg_logprob": -0.27487628173828127, "compression_ratio": 1.5454545454545454, "no_speech_prob": 0.0409037284553051}, {"id": 50, "seek": 14000, "start": 149.0, "end": 151.0, "text": " when we all want to be with our families.", "tokens": [50814, 562, 321, 439, 528, 281, 312, 365, 527, 4466, 13, 50914], "temperature": 0.0, "avg_logprob": -0.27487628173828127, "compression_ratio": 1.5454545454545454, "no_speech_prob": 0.0409037284553051}, {"id": 51, "seek": 14000, "start": 151.0, "end": 153.0, "text": " But if you come,", "tokens": [50914, 583, 498, 291, 808, 11, 51014], "temperature": 0.0, "avg_logprob": -0.27487628173828127, "compression_ratio": 1.5454545454545454, "no_speech_prob": 0.0409037284553051}, {"id": 52, "seek": 14000, "start": 153.0, "end": 156.0, "text": " well, the next best thing is to be with someone else.", "tokens": [51014, 731, 11, 264, 958, 1151, 551, 307, 281, 312, 365, 1580, 1646, 13, 51164], "temperature": 0.0, "avg_logprob": -0.27487628173828127, "compression_ratio": 1.5454545454545454, "no_speech_prob": 0.0409037284553051}, {"id": 53, "seek": 14000, "start": 156.0, "end": 158.0, "text": " You see?", "tokens": [51164, 509, 536, 30, 51264], "temperature": 0.0, "avg_logprob": -0.27487628173828127, "compression_ratio": 1.5454545454545454, "no_speech_prob": 0.0409037284553051}, {"id": 54, "seek": 14000, "start": 158.0, "end": 161.0, "text": " My family's broken up by the war, too, you know.", "tokens": [51264, 1222, 1605, 311, 5463, 493, 538, 264, 1516, 11, 886, 11, 291, 458, 13, 51414], "temperature": 0.0, "avg_logprob": -0.27487628173828127, "compression_ratio": 1.5454545454545454, "no_speech_prob": 0.0409037284553051}, {"id": 55, "seek": 14000, "start": 161.0, "end": 163.0, "text": " Oh, yes.", "tokens": [51414, 876, 11, 2086, 13, 51514], "temperature": 0.0, "avg_logprob": -0.27487628173828127, "compression_ratio": 1.5454545454545454, "no_speech_prob": 0.0409037284553051}, {"id": 56, "seek": 14000, "start": 163.0, "end": 165.0, "text": " Yes, I guess that's the problem.", "tokens": [51514, 1079, 11, 286, 2041, 300, 311, 264, 1154, 13, 51614], "temperature": 0.0, "avg_logprob": -0.27487628173828127, "compression_ratio": 1.5454545454545454, "no_speech_prob": 0.0409037284553051}, {"id": 57, "seek": 14000, "start": 165.0, "end": 167.0, "text": " Now, just be in peace.", "tokens": [51614, 823, 11, 445, 312, 294, 4336, 13, 51714], "temperature": 0.0, "avg_logprob": -0.27487628173828127, "compression_ratio": 1.5454545454545454, "no_speech_prob": 0.0409037284553051}, {"id": 58, "seek": 16700, "start": 167.0, "end": 170.0, "text": " Will you accept a little gift from me?", "tokens": [50364, 3099, 291, 3241, 257, 707, 5306, 490, 385, 30, 50514], "temperature": 0.0, "avg_logprob": -0.14772820022870908, "compression_ratio": 1.5560975609756098, "no_speech_prob": 0.018892118707299232}, {"id": 59, "seek": 16700, "start": 170.0, "end": 172.0, "text": " Captain Bedley has one for you", "tokens": [50514, 10873, 19893, 3420, 575, 472, 337, 291, 50614], "temperature": 0.0, "avg_logprob": -0.14772820022870908, "compression_ratio": 1.5560975609756098, "no_speech_prob": 0.018892118707299232}, {"id": 60, "seek": 16700, "start": 172.0, "end": 175.0, "text": " and one for you, Mr. Ensemblish.", "tokens": [50614, 293, 472, 337, 291, 11, 2221, 13, 2193, 15750, 1933, 13, 50764], "temperature": 0.0, "avg_logprob": -0.14772820022870908, "compression_ratio": 1.5560975609756098, "no_speech_prob": 0.018892118707299232}, {"id": 61, "seek": 16700, "start": 175.0, "end": 177.0, "text": " Thank you, Your Majesty.", "tokens": [50764, 1044, 291, 11, 2260, 10665, 13, 50864], "temperature": 0.0, "avg_logprob": -0.14772820022870908, "compression_ratio": 1.5560975609756098, "no_speech_prob": 0.018892118707299232}, {"id": 62, "seek": 16700, "start": 177.0, "end": 180.0, "text": " Captain Bedley, I see you have a package.", "tokens": [50864, 10873, 19893, 3420, 11, 286, 536, 291, 362, 257, 7372, 13, 51014], "temperature": 0.0, "avg_logprob": -0.14772820022870908, "compression_ratio": 1.5560975609756098, "no_speech_prob": 0.018892118707299232}, {"id": 63, "seek": 16700, "start": 180.0, "end": 184.0, "text": " Could that fly any chance to present to me?", "tokens": [51014, 7497, 300, 3603, 604, 2931, 281, 1974, 281, 385, 30, 51214], "temperature": 0.0, "avg_logprob": -0.14772820022870908, "compression_ratio": 1.5560975609756098, "no_speech_prob": 0.018892118707299232}, {"id": 64, "seek": 16700, "start": 184.0, "end": 186.0, "text": " Yes, it is, Your Majesty.", "tokens": [51214, 1079, 11, 309, 307, 11, 2260, 10665, 13, 51314], "temperature": 0.0, "avg_logprob": -0.14772820022870908, "compression_ratio": 1.5560975609756098, "no_speech_prob": 0.018892118707299232}, {"id": 65, "seek": 16700, "start": 186.0, "end": 188.0, "text": " You laugh, I guess.", "tokens": [51314, 509, 5801, 11, 286, 2041, 13, 51414], "temperature": 0.0, "avg_logprob": -0.14772820022870908, "compression_ratio": 1.5560975609756098, "no_speech_prob": 0.018892118707299232}, {"id": 66, "seek": 16700, "start": 188.0, "end": 190.0, "text": " It isn't really paper clip,", "tokens": [51414, 467, 1943, 380, 534, 3035, 7353, 11, 51514], "temperature": 0.0, "avg_logprob": -0.14772820022870908, "compression_ratio": 1.5560975609756098, "no_speech_prob": 0.018892118707299232}, {"id": 67, "seek": 16700, "start": 190.0, "end": 192.0, "text": " but that's the only box I have.", "tokens": [51514, 457, 300, 311, 264, 787, 2424, 286, 362, 13, 51614], "temperature": 0.0, "avg_logprob": -0.14772820022870908, "compression_ratio": 1.5560975609756098, "no_speech_prob": 0.018892118707299232}, {"id": 68, "seek": 19200, "start": 193.0, "end": 196.0, "text": " Let's all open our presents together, shall we?", "tokens": [50414, 961, 311, 439, 1269, 527, 13533, 1214, 11, 4393, 321, 30, 50564], "temperature": 0.0, "avg_logprob": -0.4579179551866319, "compression_ratio": 1.495, "no_speech_prob": 0.048362165689468384}, {"id": 69, "seek": 19200, "start": 202.0, "end": 204.0, "text": " So, it's a gift, Your Majesty.", "tokens": [50864, 407, 11, 309, 311, 257, 5306, 11, 2260, 10665, 13, 50964], "temperature": 0.0, "avg_logprob": -0.4579179551866319, "compression_ratio": 1.495, "no_speech_prob": 0.048362165689468384}, {"id": 70, "seek": 19200, "start": 204.0, "end": 206.0, "text": " You need your test on it, Your Majesty.", "tokens": [50964, 509, 643, 428, 1500, 322, 309, 11, 2260, 10665, 13, 51064], "temperature": 0.0, "avg_logprob": -0.4579179551866319, "compression_ratio": 1.495, "no_speech_prob": 0.048362165689468384}, {"id": 71, "seek": 19200, "start": 206.0, "end": 208.0, "text": " I've got a silver pen, knife and a pencil.", "tokens": [51064, 286, 600, 658, 257, 8753, 3435, 11, 7976, 293, 257, 10985, 13, 51164], "temperature": 0.0, "avg_logprob": -0.4579179551866319, "compression_ratio": 1.495, "no_speech_prob": 0.048362165689468384}, {"id": 72, "seek": 19200, "start": 208.0, "end": 210.0, "text": " Oh, well, I'll hang on to these.", "tokens": [51164, 876, 11, 731, 11, 286, 603, 3967, 322, 281, 613, 13, 51264], "temperature": 0.0, "avg_logprob": -0.4579179551866319, "compression_ratio": 1.495, "no_speech_prob": 0.048362165689468384}, {"id": 73, "seek": 19200, "start": 210.0, "end": 213.0, "text": " Oh, Captain Bedley, how sweet.", "tokens": [51264, 876, 11, 10873, 19893, 3420, 11, 577, 3844, 13, 51414], "temperature": 0.0, "avg_logprob": -0.4579179551866319, "compression_ratio": 1.495, "no_speech_prob": 0.048362165689468384}, {"id": 74, "seek": 19200, "start": 213.0, "end": 216.0, "text": " You know how long the chopsticks have been here.", "tokens": [51414, 509, 458, 577, 938, 264, 39443, 362, 668, 510, 13, 51564], "temperature": 0.0, "avg_logprob": -0.4579179551866319, "compression_ratio": 1.495, "no_speech_prob": 0.048362165689468384}, {"id": 75, "seek": 19200, "start": 216.0, "end": 219.0, "text": " And the soap, don't you?", "tokens": [51564, 400, 264, 14587, 11, 500, 380, 291, 30, 51714], "temperature": 0.0, "avg_logprob": -0.4579179551866319, "compression_ratio": 1.495, "no_speech_prob": 0.048362165689468384}, {"id": 76, "seek": 21900, "start": 219.0, "end": 223.0, "text": " Don't you tell me about this little thing?", "tokens": [50364, 1468, 380, 291, 980, 385, 466, 341, 707, 551, 30, 50564], "temperature": 0.0, "avg_logprob": -0.33482141963771134, "compression_ratio": 1.6326530612244898, "no_speech_prob": 0.006716855335980654}, {"id": 77, "seek": 21900, "start": 223.0, "end": 225.0, "text": " Oh, it's a redstone,", "tokens": [50564, 876, 11, 309, 311, 257, 2182, 11243, 11, 50664], "temperature": 0.0, "avg_logprob": -0.33482141963771134, "compression_ratio": 1.6326530612244898, "no_speech_prob": 0.006716855335980654}, {"id": 78, "seek": 21900, "start": 225.0, "end": 228.0, "text": " sharp and nice and red, the way it is.", "tokens": [50664, 8199, 293, 1481, 293, 2182, 11, 264, 636, 309, 307, 13, 50814], "temperature": 0.0, "avg_logprob": -0.33482141963771134, "compression_ratio": 1.6326530612244898, "no_speech_prob": 0.006716855335980654}, {"id": 79, "seek": 21900, "start": 228.0, "end": 230.0, "text": " I thought that maybe down in the kitchen", "tokens": [50814, 286, 1194, 300, 1310, 760, 294, 264, 6525, 50914], "temperature": 0.0, "avg_logprob": -0.33482141963771134, "compression_ratio": 1.6326530612244898, "no_speech_prob": 0.006716855335980654}, {"id": 80, "seek": 21900, "start": 230.0, "end": 232.0, "text": " or maybe the king had a reason to teach.", "tokens": [50914, 420, 1310, 264, 4867, 632, 257, 1778, 281, 2924, 13, 51014], "temperature": 0.0, "avg_logprob": -0.33482141963771134, "compression_ratio": 1.6326530612244898, "no_speech_prob": 0.006716855335980654}, {"id": 81, "seek": 21900, "start": 232.0, "end": 235.0, "text": " Oh, I'm sure it's a very big need.", "tokens": [51014, 876, 11, 286, 478, 988, 309, 311, 257, 588, 955, 643, 13, 51164], "temperature": 0.0, "avg_logprob": -0.33482141963771134, "compression_ratio": 1.6326530612244898, "no_speech_prob": 0.006716855335980654}, {"id": 82, "seek": 21900, "start": 235.0, "end": 238.0, "text": " I know these things are in your Christmas boxes from home", "tokens": [51164, 286, 458, 613, 721, 366, 294, 428, 5272, 9002, 490, 1280, 51314], "temperature": 0.0, "avg_logprob": -0.33482141963771134, "compression_ratio": 1.6326530612244898, "no_speech_prob": 0.006716855335980654}, {"id": 83, "seek": 21900, "start": 238.0, "end": 242.0, "text": " and I think it's very generous of you to share them with me.", "tokens": [51314, 293, 286, 519, 309, 311, 588, 14537, 295, 291, 281, 2073, 552, 365, 385, 13, 51514], "temperature": 0.0, "avg_logprob": -0.33482141963771134, "compression_ratio": 1.6326530612244898, "no_speech_prob": 0.006716855335980654}, {"id": 84, "seek": 21900, "start": 242.0, "end": 243.0, "text": " How do you like it?", "tokens": [51514, 1012, 360, 291, 411, 309, 30, 51564], "temperature": 0.0, "avg_logprob": -0.33482141963771134, "compression_ratio": 1.6326530612244898, "no_speech_prob": 0.006716855335980654}, {"id": 85, "seek": 21900, "start": 243.0, "end": 245.0, "text": " Join the other guests and go into dinner.", "tokens": [51564, 19642, 264, 661, 9804, 293, 352, 666, 6148, 13, 51664], "temperature": 0.0, "avg_logprob": -0.33482141963771134, "compression_ratio": 1.6326530612244898, "no_speech_prob": 0.006716855335980654}, {"id": 86, "seek": 24500, "start": 245.0, "end": 249.0, "text": " Oh, Captain Bedley, you always fit on my list.", "tokens": [50364, 876, 11, 10873, 19893, 3420, 11, 291, 1009, 3318, 322, 452, 1329, 13, 50564], "temperature": 0.0, "avg_logprob": -0.2589398447672526, "compression_ratio": 1.3863636363636365, "no_speech_prob": 0.003715566825121641}, {"id": 87, "seek": 24500, "start": 249.0, "end": 253.0, "text": " I would like to hear about a list of your family", "tokens": [50564, 286, 576, 411, 281, 1568, 466, 257, 1329, 295, 428, 1605, 50764], "temperature": 0.0, "avg_logprob": -0.2589398447672526, "compression_ratio": 1.3863636363636365, "no_speech_prob": 0.003715566825121641}, {"id": 88, "seek": 24500, "start": 253.0, "end": 256.0, "text": " and all the things you do at home.", "tokens": [50764, 293, 439, 264, 721, 291, 360, 412, 1280, 13, 50914], "temperature": 0.0, "avg_logprob": -0.2589398447672526, "compression_ratio": 1.3863636363636365, "no_speech_prob": 0.003715566825121641}, {"id": 89, "seek": 24500, "start": 262.0, "end": 265.0, "text": " When Lieutenant Bresch and I left at midnight,", "tokens": [51214, 1133, 28412, 363, 495, 339, 293, 286, 1411, 412, 19006, 11, 51364], "temperature": 0.0, "avg_logprob": -0.2589398447672526, "compression_ratio": 1.3863636363636365, "no_speech_prob": 0.003715566825121641}, {"id": 90, "seek": 24500, "start": 265.0, "end": 269.0, "text": " it was as if we'd spent an evening with old friends.", "tokens": [51364, 309, 390, 382, 498, 321, 1116, 4418, 364, 5634, 365, 1331, 1855, 13, 51564], "temperature": 0.0, "avg_logprob": -0.2589398447672526, "compression_ratio": 1.3863636363636365, "no_speech_prob": 0.003715566825121641}, {"id": 91, "seek": 24500, "start": 269.0, "end": 271.0, "text": " It was great.", "tokens": [51564, 467, 390, 869, 13, 51664], "temperature": 0.0, "avg_logprob": -0.2589398447672526, "compression_ratio": 1.3863636363636365, "no_speech_prob": 0.003715566825121641}, {"id": 92, "seek": 27100, "start": 271.0, "end": 273.0, "text": " Must close now.", "tokens": [50364, 13252, 1998, 586, 13, 50464], "temperature": 0.0, "avg_logprob": -0.26977613994053434, "compression_ratio": 0.896551724137931, "no_speech_prob": 0.10575101524591446}, {"id": 93, "seek": 27100, "start": 273.0, "end": 275.0, "text": " Hope you're all well.", "tokens": [50464, 6483, 291, 434, 439, 731, 13, 50564], "temperature": 0.0, "avg_logprob": -0.26977613994053434, "compression_ratio": 0.896551724137931, "no_speech_prob": 0.10575101524591446}, {"id": 94, "seek": 27100, "start": 275.0, "end": 278.0, "text": " Well, darling.", "tokens": [50564, 1042, 11, 22405, 13, 50714], "temperature": 0.0, "avg_logprob": -0.26977613994053434, "compression_ratio": 0.896551724137931, "no_speech_prob": 0.10575101524591446}], "language": "en"}